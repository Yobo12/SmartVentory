# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- App ---
APP_NAME=SmartVentory
DEBUG=True

# --- Database ---
# Format: postgresql://<user>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql://postgres:password@localhost:5432/smartventory_db

# --- JWT Auth ---
# Generate a strong key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- AI Module (Phase 7) ---
GEMINI_API_KEY=

# --- CORS ---
# Comma-separated origins allowed to call the API from the browser frontend.
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
